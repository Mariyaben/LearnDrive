# Copy to secrets.properties (git-ignored; never commit it) and enter the Android-restricted
# development key. It is copied into the app's manifest metadata only.
MAPS_API_KEY=
# Optional: a key for the Google Maps Elevation API, which tells the coach about hills along the
# route. Leave it empty to use the Maps key; either way, enable the Elevation API for that key.
ELEVATION_API_KEY=
